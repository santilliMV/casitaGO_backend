# Copia este archivo a .env y reemplaza con los valores reales.
# En Render, estas mismas variables se cargan en Environment del servicio.
# NUNCA subas .env al repositorio (ya está en .gitignore).

# ---------- Base de datos (Supabase) ----------
# Usa la conexión del "Session pooler": Supabase > Connect > Session pooler.
# La conexión directa (db.xxxx.supabase.co) solo funciona por IPv6 y Render no
# lo soporta: desde Render el backend no podría conectarse.
# Ojo: con el pooler el usuario lleva el ID del proyecto (postgres.xxxxxxxxxxxx).
DB_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:5432/postgres
DB_USER=postgres.xxxxxxxxxxxx
DB_PASSWORD=tu-password-de-supabase

# ---------- Seguridad ----------
# Genera un secreto largo y aleatorio, mínimo 32 caracteres.
JWT_SECRET=reemplaza-esto-por-un-secreto-largo-y-aleatorio

# Dominios del frontend que pueden llamar a la API, separados por comas.
# En local: http://localhost:4200. En Render: la URL del frontend, p. ej. https://casitago.onrender.com
CORS_ORIGINS=http://localhost:4200

# ---------- Imágenes (Supabase Storage) ----------
# Supabase > Project Settings > API: Project URL y la llave service_role.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=tu-llave-service-role

# ---------- Correo (Brevo) ----------
# En Render usa MAIL_PORT=2525: el plan gratis bloquea los puertos 25, 465 y 587.
MAIL_HOST=smtp-relay.sendinblue.com
MAIL_PORT=587
MAIL_USER=tu-usuario-smtp-de-brevo
MAIL_PASSWORD=tu-llave-smtp-de-brevo
MAIL_REMITENTE=correo-verificado-en-brevo@ejemplo.com

# ---------- Pagos (Stripe en modo de prueba) ----------
# Debe empezar por sk_test_: los pagos del proyecto son simulados.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx

# ---------- Servidor ----------
# Render asigna PORT automáticamente; en local se usa 8080 si no se define.
PORT=8080
