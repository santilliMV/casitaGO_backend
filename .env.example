# Copia este archivo a .env y reemplaza con los valores reales de tu proyecto Supabase.
# NUNCA subas .env al repositorio (ya está en .gitignore).

# Project Settings > Database > Connection string (modo Session, puerto 5432)
DB_URL=jdbc:postgresql://db.xxxxxxxxxxxx.supabase.co:5432/postgres
DB_USER=postgres
DB_PASSWORD=tu-password-de-supabase

# Genera un secreto largo y aleatorio, mínimo 32 caracteres.
JWT_SECRET=reemplaza-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRATION_MINUTES=60

PORT=8080
